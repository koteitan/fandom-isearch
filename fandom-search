class CliError(Exception):
    pass


def default_db_path() -> Path:
    if MANIFEST.is_file():
        try:
            document = json.loads(MANIFEST.read_text(encoding="utf-8"))
            for entry in document.get("databases", []):
                filename = entry.get("file", "")
                if isinstance(filename, str) and Path(filename).name == filename:
                    candidate = DB_DIR / filename
                    if candidate.is_file():
                        return candidate
        except (OSError, TypeError, json.JSONDecodeError):
            pass
    databases = sorted(DB_DIR.glob("*.db"))
    return databases[0] if databases else DB_DIR / "<archive-name>.db"


def open_db(path: Path) -> sqlite3.Connection:
    path = path.expanduser().resolve()
    if not path.is_file():
        raise CliError(tr("db_missing", path=path))
    try:
        db = sqlite3.connect(path.as_uri() + "?mode=ro", uri=True)
        db.row_factory = sqlite3.Row
        db.text_factory = str
        version = db.execute("PRAGMA user_version").fetchone()[0]
        if version != 1:
            db.close()
            raise CliError(tr("db_unsupported", path=path, version=version))
        db.execute("SELECT 1 FROM pages LIMIT 1").fetchone()
        return db
    except sqlite3.Error as error:
        raise CliError(tr("db_open_failed", path=path, error=error)) from error


def metadata(db: sqlite3.Connection) -> dict[str, str]:
    return {row["key"]: row["value"] for row in db.execute("SELECT key, value FROM metadata")}


def namespace_rows(db: sqlite3.Connection) -> list[sqlite3.Row]:
    return list(db.execute("SELECT id, name, page_count FROM namespaces ORDER BY id"))


def namespace_label(namespace_id: int, name: str) -> str:
    if namespace_id == 0:
        return tr("standard_namespace")
    return name or tr("unnamed_namespace", id=namespace_id)


def print_targets() -> None:
