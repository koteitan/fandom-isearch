#!/usr/bin/env python3
"""Build a browser-searchable SQLite database from a MediaWiki XML dump."""

from __future__ import annotations

import argparse
import bz2
from collections import Counter
from datetime import datetime, timezone
import gzip
import json
import os
from pathlib import Path
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
from typing import BinaryIO
from urllib.error import HTTPError, URLError
from urllib.parse import urlsplit, urlunsplit
from urllib.request import Request, urlopen
from xml.etree.ElementTree import ParseError, iterparse


ROOT = Path(__file__).resolve().parent
DB_DIR = ROOT / "web" / "db"
SCHEMA_VERSION = 1
LICENSE_PAGE_NAMES = {
    "copyright",
    "copyrights",
    "licence",
    "license",
    "licensing",
    "ライセンス",
    "著作権",
}
CREATIVE_COMMONS_URL = re.compile(
    r"https?://creativecommons\.org/licenses/"
    r"(?P<code>[a-z]+(?:-[a-z]+)*)/(?P<version>\d+(?:\.\d+)?)/",
    re.IGNORECASE,
)
FANDOM_WIKI_ID = re.compile(r"^[a-z0-9][a-z0-9_-]*$", re.IGNORECASE)
WIKI_REDIRECT = re.compile(
    r"^\s*#redirect\s*\[\[([^\]|#]+)(?:#[^\]|]+)?(?:\|[^\]]*)?\]\]",
    re.IGNORECASE,
)


def app_version() -> str:
    try:
        return str(json.loads((ROOT / "web" / "version.json").read_text())["version"])
    except (OSError, KeyError, TypeError, json.JSONDecodeError):
        return "unknown"


def local_name(tag: str) -> str:
    return tag.rsplit("}", 1)[-1]


def child(element, name: str):
    return next((item for item in element if local_name(item.tag) == name), None)


def text(element) -> str:
    return "" if element is None or element.text is None else element.text


def archive_name(path: Path) -> str:
    name = path.name
    for suffix in (".bz2", ".gz"):
        if name.lower().endswith(suffix):
            name = name[: -len(suffix)]
            break
    if name.lower().endswith(".xml"):
        name = name[:-4]
    elif "." in name:
        name = name.rsplit(".", 1)[0]
    name = re.sub(r"[^\w.-]+", "_", name, flags=re.UNICODE).strip("._")
    if not name:
        raise ValueError("アーカイブ名からDBファイル名を作れません")
    return name


def open_dump(path: Path) -> BinaryIO:
    lower = path.name.lower()
    if lower.endswith(".gz"):
        return gzip.open(path, "rb")
    if lower.endswith(".bz2"):
        return bz2.open(path, "rb")
    return path.open("rb")


def fandom_dump_url(wiki_id: str) -> str:
    filename = f"{wiki_id}_pages_current.xml.7z"
    return (
        "https://s3.amazonaws.com/wikia_xml_dumps/"
        f"{wiki_id[0]}/{wiki_id[:2]}/{filename}"
    )


def download_dump(wiki_id: str, destination: Path) -> None:
    url = fandom_dump_url(wiki_id)
    print(f"Fandom Current pages をダウンロードします:\n  {url}", flush=True)
    request = Request(url, headers={"User-Agent": f"fandom-isearch/{app_version()}"})
    try:
        with urlopen(request, timeout=60) as response, destination.open("wb") as output:
            expected = int(response.headers.get("Content-Length", "0") or 0)
            downloaded = 0
            next_report = 10 * 1024 * 1024
            while chunk := response.read(1024 * 1024):
                output.write(chunk)
                downloaded += len(chunk)
                if downloaded >= next_report:
                    if expected:
                        print(
                            f"  {downloaded / (1024 * 1024):.1f} / "
                            f"{expected / (1024 * 1024):.1f} MiB",
                            flush=True,
                        )
                    else:
                        print(f"  {downloaded / (1024 * 1024):.1f} MiB", flush=True)
                    next_report += 10 * 1024 * 1024
    except HTTPError as error:
        if error.code == 404:
            raise RuntimeError(
                f"Fandomダンプが見つかりません: {wiki_id} "
                "(Wiki IDを確認するか、Special:Statisticsで生成を依頼してください)"
            ) from error
        raise RuntimeError(
            f"Fandomダンプを取得できませんでした (HTTP {error.code})"
        ) from error
    except URLError as error:
        raise RuntimeError(f"Fandomダンプを取得できませんでした: {error.reason}") from error

    actual = destination.stat().st_size
    if expected and actual != expected:
        raise RuntimeError(
            f"ダウンロードが不完全です: {actual:,} / {expected:,} bytes"
        )
    print(f"  ダウンロード完了: {actual / (1024 * 1024):.1f} MiB", flush=True)


def extract_7z(archive: Path, destination: Path, expected_name: str) -> Path:
    print("  7zアーカイブを展開しています…", flush=True)
    for command_name in ("7zz", "7z", "7zr"):
        command = shutil.which(command_name)
        if command is None:
            continue
        result = subprocess.run(
            [command, "x", "-y", f"-o{destination}", str(archive), expected_name],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode != 0:
            detail = result.stderr.strip() or result.stdout.strip()
            raise RuntimeError(f"7zアーカイブを展開できませんでした: {detail}")
        break
    else:
        try:
            import py7zr
        except ImportError as error:
            raise RuntimeError(
                "7zの展開機能がありません。7-Zipをインストールするか、"
                "python3 -m pip install py7zr を実行してください"
            ) from error
        try:
            with py7zr.SevenZipFile(archive, mode="r") as seven_zip:
                names = seven_zip.getnames()
                if expected_name not in names:
                    raise RuntimeError(
                        f"7z内に {expected_name} がありません: {', '.join(names)}"
                    )
                seven_zip.extract(path=destination, targets=[expected_name])
        except RuntimeError:
            raise
        except Exception as error:
            raise RuntimeError(f"7zアーカイブを展開できませんでした: {error}") from error

    extracted = destination / expected_name
    if not extracted.is_file():
        raise RuntimeError(f"7z内に {expected_name} がありません")
    return extracted


def parse_timestamp(value: str) -> int:
    if not value:
        return 0
    try:
        return int(datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp())
    except ValueError:
        return 0


def wiki_base_url(base: str) -> str:
    """Turn siteinfo/base (the main-page URL) into the wiki article prefix."""
    if not base:
        return ""
    parts = urlsplit(base)
    path = parts.path
    marker = "/wiki/"
    if marker in path:
        path = path.split(marker, 1)[0] + marker
    elif not path.endswith("/"):
        path += "/"
    scheme = "https" if parts.scheme in ("http", "https") else parts.scheme
    return urlunsplit((scheme, parts.netloc, path, "", ""))


def license_metadata(title: str, body: str) -> dict[str, str]:
    """Extract a Creative Commons notice from a copyright-page body."""
    match = CREATIVE_COMMONS_URL.search(body)
    if match is None:
        return {}
    code = match.group("code").lower()
    version = match.group("version")
    notice = body.strip().split("\n\n", 1)[0].strip()
    return {
        "license_name": f"CC {code.upper()} {version}",
        "license_url": f"https://creativecommons.org/licenses/{code}/{version}/",
        "license_source_title": title,
        "license_notice": notice,
        "license_scope": "wiki_text",
    }


def find_license_metadata(project_pages: dict[str, str]) -> dict[str, str]:
    """Find a project copyright page, following ordinary wiki redirects."""
    for source_title, source_body in project_pages.items():
        page_name = source_title.rsplit(":", 1)[-1].strip().casefold()
        if page_name not in LICENSE_PAGE_NAMES:
            continue
        body = source_body
        visited = {source_title}
        for _ in range(5):
            redirect = WIKI_REDIRECT.match(body)
            if redirect is None:
                break
            target = redirect.group(1).strip()
            if target in visited or target not in project_pages:
                break
            visited.add(target)
            body = project_pages[target]
        metadata = license_metadata(source_title, body)
        if metadata:
            return metadata
    return {}


def check_fts5() -> None:
    connection = sqlite3.connect(":memory:")
    try:
        connection.execute(
            "CREATE VIRTUAL TABLE fts_check USING fts5("
            "value, tokenize='trigram', detail='column')"
        )
    except sqlite3.Error as error:
        raise RuntimeError(
            "この Python の SQLite では FTS5 trigram が使えません "
            f"(SQLite {sqlite3.sqlite_version}): {error}"
        ) from error
    finally:
        connection.close()


def pages_from_dump(stream: BinaryIO):
    namespaces: dict[int, str] = {}
    site: dict[str, str] = {}
    in_siteinfo = False

    for event, element in iterparse(stream, events=("start", "end")):
        name = local_name(element.tag)
        if event == "start":
            if name == "siteinfo":
                in_siteinfo = True
            continue

        if in_siteinfo and name == "namespace":
            namespaces[int(element.attrib["key"])] = text(element)
        elif in_siteinfo and name in ("sitename", "dbname", "base", "generator"):
            site[name] = text(element)
        elif name == "siteinfo":
            in_siteinfo = False
            element.clear()
        elif name == "page":
            revision = child(element, "revision")
            if revision is not None:
                contributor = child(revision, "contributor")
                author = ""
                if contributor is not None:
                    author = text(child(contributor, "username")) or text(
                        child(contributor, "ip")
                    )
                yield (
                    int(text(child(element, "id"))),
                    int(text(child(element, "ns"))),
                    text(child(element, "title")),
                    text(child(revision, "text")),
                    author,
                    int(text(child(revision, "id")) or 0),
                    parse_timestamp(text(child(revision, "timestamp"))),
                ), namespaces, site
            element.clear()


def create_database(source: Path, destination: Path) -> dict[str, object]:
    fd, temporary_name = tempfile.mkstemp(
        prefix=f".{destination.name}.", suffix=".tmp", dir=destination.parent
    )
    os.close(fd)
    temporary = Path(temporary_name)
    connection = None
    counts: Counter[int] = Counter()
    namespaces: dict[int, str] = {}
    site: dict[str, str] = {}
    project_pages: dict[str, str] = {}
    page_count = 0

    try:
        connection = sqlite3.connect(temporary)
        connection.executescript(
            """
            PRAGMA journal_mode=OFF;
            PRAGMA synchronous=OFF;
            PRAGMA temp_store=MEMORY;
            PRAGMA locking_mode=EXCLUSIVE;
            PRAGMA page_size=4096;

            CREATE TABLE metadata (
                key TEXT PRIMARY KEY,
                value TEXT NOT NULL
            ) WITHOUT ROWID;

            CREATE TABLE namespaces (
                id INTEGER PRIMARY KEY,
                name TEXT NOT NULL,
                page_count INTEGER NOT NULL
            );

            CREATE TABLE pages (
                id INTEGER PRIMARY KEY,
                namespace INTEGER NOT NULL,
                title TEXT NOT NULL,
                body TEXT NOT NULL,
                author TEXT NOT NULL,
                revision_id INTEGER NOT NULL,
                updated_at INTEGER NOT NULL
            );
            """
        )

        batch = []
        with open_dump(source) as stream:
            for record, current_namespaces, current_site in pages_from_dump(stream):
                batch.append(record)
                counts[record[1]] += 1
                page_count += 1
                namespaces = current_namespaces
                site = current_site
                if record[1] == 4:
                    project_pages[record[2]] = record[3]
                if len(batch) >= 500:
                    connection.executemany(
                        "INSERT INTO pages VALUES (?, ?, ?, ?, ?, ?, ?)", batch
                    )
                    batch.clear()
                    if page_count % 5000 == 0:
                        print(f"  {page_count:,} ページを読み込みました…", flush=True)
        if batch:
            connection.executemany(
                "INSERT INTO pages VALUES (?, ?, ?, ?, ?, ?, ?)", batch
            )

        if page_count == 0:
            raise RuntimeError("XML にページが見つかりません")

        connection.executemany(
            "INSERT INTO namespaces(id, name, page_count) VALUES (?, ?, ?)",
            [
                (namespace_id, namespaces.get(namespace_id, ""), count)
                for namespace_id, count in sorted(counts.items())
            ],
        )
        generated_at = datetime.now(timezone.utc).isoformat(timespec="seconds")
        metadata = {
            "archive_name": destination.stem,
            "site_name": site.get("sitename", destination.stem),
            "wiki_dbname": site.get("dbname", ""),
            "wiki_base_url": wiki_base_url(site.get("base", "")),
            "mediawiki_generator": site.get("generator", ""),
            "generated_at": generated_at,
            "page_count": str(page_count),
        }
        metadata.update(find_license_metadata(project_pages))
        connection.executemany(
            "INSERT INTO metadata(key, value) VALUES (?, ?)", metadata.items()
        )

        print("  検索インデックスを作成しています…", flush=True)
        connection.executescript(
            """
            CREATE INDEX pages_updated_at_idx
                ON pages(updated_at DESC, id DESC);
            CREATE INDEX pages_namespace_updated_at_idx
                ON pages(namespace, updated_at DESC, id DESC);

            CREATE VIRTUAL TABLE page_search USING fts5(
                title,
                body,
                author,
                content='pages',
                content_rowid='id',
                tokenize='trigram',
                detail='column'
            );
            INSERT INTO page_search(page_search) VALUES('rebuild');
            INSERT INTO page_search(page_search) VALUES('optimize');
            """
        )
        connection.execute(f"PRAGMA user_version={SCHEMA_VERSION}")
        connection.commit()
        integrity = connection.execute("PRAGMA integrity_check").fetchone()[0]
        if integrity != "ok":
            raise RuntimeError(f"SQLite integrity_check に失敗しました: {integrity}")
        connection.close()
        connection = None
        os.replace(temporary, destination)
        return {
            "file": destination.name,
            "name": destination.stem,
            "siteName": metadata["site_name"],
            "pages": page_count,
            "generatedAt": generated_at,
        }
    except Exception:
        if connection is not None:
            connection.close()
        temporary.unlink(missing_ok=True)
        raise


def update_manifest(entry: dict[str, object]) -> None:
    path = DB_DIR / "databases.json"
    entries: list[dict[str, object]] = []
    if path.exists():
        try:
            document = json.loads(path.read_text(encoding="utf-8"))
            entries = list(document.get("databases", []))
        except (json.JSONDecodeError, OSError, TypeError):
            entries = []
    entries = [item for item in entries if item.get("file") != entry["file"]]
    entries.append(entry)
    entries.sort(key=lambda item: str(item.get("name", "")).casefold())
    document = {"schemaVersion": SCHEMA_VERSION, "databases": entries}

    fd, temporary_name = tempfile.mkstemp(
        prefix=".databases.json.", suffix=".tmp", dir=DB_DIR
    )
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(document, stream, ensure_ascii=False, indent=2)
            stream.write("\n")
        os.replace(temporary_name, path)
    except Exception:
        Path(temporary_name).unlink(missing_ok=True)
        raise


def main() -> int:
    parser = argparse.ArgumentParser(
        description="MediaWiki XML アーカイブから fandom-isearch 用DBを作成します"
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {app_version()}")
    parser.add_argument(
        "archive",
        help="Fandom Wiki ID または MediaWiki XML (.xml/.gz/.bz2)",
    )
    args = parser.parse_args()
    requested = args.archive
    local_source = Path(requested).expanduser()
    wiki_id = ""
    if local_source.is_file():
        local_source = local_source.resolve()
    elif FANDOM_WIKI_ID.fullmatch(requested):
        wiki_id = requested.lower()
    else:
        parser.error(f"ファイルがないか、Fandom Wiki IDが不正です: {requested}")

    try:
        check_fts5()
        DB_DIR.mkdir(parents=True, exist_ok=True)
        if wiki_id:
            xml_name = f"{wiki_id}_pages_current.xml"
            destination = DB_DIR / f"{wiki_id}_pages_current.db"
            with tempfile.TemporaryDirectory(prefix=f"fandom-isearch-{wiki_id}-") as name:
                work = Path(name)
                archive = work / f"{xml_name}.7z"
                download_dump(wiki_id, archive)
                source = extract_7z(archive, work, xml_name)
                print(f"{source.name} → {destination}", flush=True)
                entry = create_database(source, destination)
        else:
            destination = DB_DIR / f"{archive_name(local_source)}.db"
            print(f"{local_source} → {destination}", flush=True)
            entry = create_database(local_source, destination)
        update_manifest(entry)
    except (OSError, ValueError, RuntimeError, ParseError, sqlite3.Error) as error:
        print(f"makedb: {error}", file=sys.stderr)
        return 1

    size_mb = destination.stat().st_size / (1024 * 1024)
    print(f"完了: {entry['pages']:,} ページ / {size_mb:.1f} MiB")
    print("閲覧: ./serve を実行して http://127.0.0.1:8000/ を開いてください")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
